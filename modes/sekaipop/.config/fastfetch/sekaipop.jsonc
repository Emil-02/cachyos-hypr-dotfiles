{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "width": 28,
    "height": 13,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan", "title": "magenta", "separator": "blue" }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{#1;35}󰣇 {user-name}{#0}{#36} @ {host-name}" },
    { "type": "custom", "format": "{#34}╭──────────────────" },
    { "type": "os", "key": "│  os     ", "keyColor": "blue", "format": "{name}" },
    { "type": "kernel", "key": "│  kernel ", "keyColor": "blue", "format": "{release}" },
    { "type": "uptime", "key": "│  uptime ", "keyColor": "cyan" },
    { "type": "packages", "key": "│  paket  ", "keyColor": "cyan", "format": "{all} terpasang" },
    { "type": "wm", "key": "│  wm     ", "keyColor": "magenta", "format": "{pretty-name}" },
    { "type": "terminal", "key": "│  term   ", "keyColor": "magenta", "format": "{pretty-name}" },
    { "type": "memory", "key": "│  ram    ", "keyColor": "green", "format": "{used} / {total}" },
    { "type": "battery", "key": "│  baterai", "keyColor": "green", "format": "{capacity}" },
    { "type": "media", "key": "│  lagu   ", "keyColor": "yellow", "format": "{title:22}" },
    { "type": "custom", "format": "{#34}╰──────────────────" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
