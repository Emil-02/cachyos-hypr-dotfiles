
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  
"logo": {
  "type": "kitty",
  "source": "~/.config/fastfetch/Koi.png",
  "width": 42,
  "height": 22,
  "padding": {
    "top": 1,
    "right": 3,
    "left": 3
  }
},
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "green"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "break",
    "colors"
  ]
}
